# 复制为 .env 后按需修改，改完需重启进程。
# Docker Compose 会通过 env_file 加载本文件；已存在的环境变量优先于文件。

# 监听（本机 npm 默认 127.0.0.1；compose 里会覆盖为 0.0.0.0）
HOST=127.0.0.1
PORT=3780

# 存储驱动：sqlite（默认）| postgres | file（遗留 JSON）
STORE_DRIVER=sqlite

# SQLite 库路径（相对仓库根或绝对路径）；STORE_DRIVER=sqlite 时生效
SQLITE_PATH=data/app.sqlite

# PostgreSQL 连接串；STORE_DRIVER=postgres 时必填
# 示例：postgresql://postgres:postgres@127.0.0.1:5432/cursor_team_usage
DATABASE_URL=

# 插件 /api/agent/report 鉴权密钥（与扩展 cursorTeamUsage.accessKey 一致）
# 默认 ctu-change-me 仅便于开箱试用；生产环境请务必改成自有密钥
# 若要关闭插件上报，可设为空：ACCESS_KEY=
ACCESS_KEY=ctu-change-me

# 每个账号距「上次用量更新」的刷新间隔（秒）；0=关闭自动刷新
# 按账号 lastSyncedAt 错开，不会每隔 N 秒全员齐刷
AUTO_REFRESH_SEC=900

# 同一账号允许的活跃使用人数（按 Reporter 最近 90 分钟上报的主机统计）
PRO_MAX_USERS=3
PRO_PLUS_MAX_USERS=5

# 应用操作日志保留天数（data/log 下按日分文件）；0=不自动删除
LOG_RETENTION_DAYS=30

# 控制台登录 Cookie 签名密钥；首次启动若为空会自动生成并写入 .env
SESSION_SECRET=

# 看板对外根地址。一键安装插件只认这个值（不看浏览器地址），必填。
# 例：部署在局域网时写成机器 IP，否则插件不知道该连哪台。
PUBLIC_BASE_URL=http://192.168.100.104:3780

# 时区（定时任务按本地时间；容器内建议 Asia/Shanghai）
# TZ=Asia/Shanghai

# 通知推送（目前仅企业微信群机器人）
# NOTIFY_CHANNEL=wecom
# NOTIFY_BOT_ID=企微机器人 key（或完整 webhook URL）
# 每日本地时间推送临期且额度充足的可切换账号；默认 09:30
# NOTIFY_HOUR=9
# NOTIFY_MINUTE=30
